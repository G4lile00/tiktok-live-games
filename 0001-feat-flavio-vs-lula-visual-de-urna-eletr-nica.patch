+  height: 100%;
+  object-fit: cover;
+  display: block;
+}
+
+.cand b {
+  position: absolute;
+  top: 0;
+  right: 0;
+  padding: 0.1cqw 0.5cqw;
+  background: var(--side-color);
+  color: #fff;
+  font-size: 1.3cqw;
+  font-weight: 900;
+}
+
+.urn[data-state="confirm"] .cand {
+  opacity: 1;
+  transform: scale(1);
+}
+
+/* "FIM" screen */
+.end-screen {
+  position: absolute;
+  inset: 0;
+  display: none;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 0.6cqw;
+  background: #0a0d10;
+}
+
+.urn[data-state="done"] .vote-screen {
+  display: none;
+}
+
+.urn[data-state="done"] .end-screen {
+  display: flex;
+}
+
+.end-title {
+  font-size: 5.2cqw;
+  font-weight: 900;
+  letter-spacing: 0.2cqw;
+  color: #fff;
+}
+
+.end-sub {
+  font-size: 0.9cqw;
+  font-weight: 700;
+  color: #5cff8a;
+}
+
+/* Keypad */
+.urn-keypad {
+  align-self: start;
+  padding: 1cqw;
+  border-radius: 0.8cqw;
+  background: #15171a;
+  box-shadow: inset 0 0 0.6cqw #000;
+}
+
+.keys {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 0.6cqw;
+}
+
+.key {
+  height: 2.3cqw;
+  border-radius: 0.4cqw;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  font-size: 1.3cqw;
+  font-weight: 700;
+  color: #fff;
+  background: linear-gradient(180deg, #5b5f67, #3a3d43);
+  box-shadow: 0 0.15cqw 0 #0a0a0a;
+  transition:
+    background 0.08s ease,
+    transform 0.08s ease;
+}
+
+.key[data-key="0"] {
+  grid-column: 2;
+}
+
+.key.pressed {
+  background: #fff;
+  color: #000;
+  transform: translateY(0.15cqw) scale(0.93);
+}
+
+.keys-actions {
+  display: grid;
+  grid-template-columns: 1fr 1fr 1.2fr;
+  gap: 0.5cqw;
+  margin-top: 1cqw;
+}
+
+.act {
+  height: 2.3cqw;
+  border-radius: 0.4cqw;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  font-size: 0.7cqw;
+  font-weight: 800;
+  color: #222;
+  transition:
+    transform 0.08s ease,
+    filter 0.08s ease;
+}
+
+.act.blank {
+  background: #fafafa;
+}
+.act.fix {
+  background: #f4a93a;
+}
+.act.confirm {
+  background: #3fbf5a;
+  color: #04200c;
+}
+
+.act.pressed {
+  transform: translateY(0.15cqw) scale(0.93);
+  filter: brightness(1.4);
+}
+
+/* Typing hand (arm sleeve takes the side color) */
+.urn-hand {
+  position: absolute;
+  left: 0;
+  top: 0;
+  width: 7.5cqw;
+  z-index: 5;
+  pointer-events: none;
+  transition:
+    left 0.16s ease,
+    top 0.16s ease,
+    transform 0.1s ease;
+  filter: drop-shadow(0 0.3cqw 0.4cqw rgba(0, 0, 0, 0.35));
+}
+
+.urn-hand svg {
+  display: block;
+  width: 100%;
+  height: auto;
+}
+
+.urn-hand.tap {
+  transform: translateY(0.4cqw) scale(0.96);
 }
 
